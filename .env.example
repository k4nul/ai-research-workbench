# PostgreSQL connection used by the web app, migration, seed, and export scripts.
DATABASE_URL=postgresql://research:research@localhost:55432/research_workbench
# Tests use a separate database and refuse destructive resets without a test-like name.
TEST_DATABASE_URL=postgresql://research:research@localhost:55432/research_workbench_test

# Demo mode is the default. It exercises every AI/search pipeline stage with deterministic fixtures.
DEMO_MODE=true

# Optional live AI provider. Leave blank to keep the mock provider active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional live web-search provider. Leave blank to keep deterministic mock search active.
BRAVE_SEARCH_API_KEY=

# Local origin displayed in settings and used by screenshots/browser tests.
APP_URL=http://localhost:3100

# Optional explicit font file for required PDF language coverage.
PDF_FONT_PATH=

# Bounded upload/fetch limits. Values are bytes and milliseconds.
MAX_UPLOAD_BYTES=5242880
MAX_FETCH_BYTES=2097152
FETCH_TIMEOUT_MS=10000

# Directory for private uploaded source files and generated delivery bundles. Do not point at a public web root.
STORAGE_DIR=./.data
