{
  "name": "ai-research-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first research operations workbench for small research teams.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3100",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:prepare && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run test:prepare && vitest run tests/integration",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/reset-database.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "npm run db:start && npm run db:migrate && npm run seed",
    "export-demo": "tsx scripts/export-demo.ts",
    "doctor": "tsx scripts/doctor.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "archiver": "8.0.0",
    "docx": "9.7.1",
    "lucide-react": "^0.542.0",
    "next": "16.3.3",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "undici": "^7.16.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/archiver": "8.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "2.16.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
