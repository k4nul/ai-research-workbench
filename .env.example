# PostgreSQL connection used by the web app, migration, seed, and export scripts.
DATABASE_URL=postgresql://research:research@localhost:55432/research_workbench
DATABASE_POOL_SIZE=10
# Tests use a separate database and refuse destructive resets without a test-like name.
TEST_DATABASE_URL=postgresql://research:research@localhost:55432/research_workbench_test

# Demo mode is the default. It exercises every AI/search pipeline stage with deterministic fixtures.
DEMO_MODE=true

# Optional live AI provider. Leave blank to keep the mock provider active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional live web-search provider. Leave blank to keep deterministic mock search active.
BRAVE_SEARCH_API_KEY=

# Local origin displayed in settings and used by screenshots/browser tests.
APP_URL=http://localhost:3100
APP_BIND_HOST=127.0.0.1

# Separate worker and PostgreSQL lease controls. Lease must exceed 2x heartbeat.
WORKER_ID=
SERVICE_VERSION=0.2.0
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=500
WORKER_SHUTDOWN_GRACE_MS=30000
JOB_LEASE_DURATION_MS=30000
JOB_HEARTBEAT_INTERVAL_MS=10000
JOB_DEFAULT_TIMEOUT_MS=300000
JOB_MAX_ATTEMPTS=3
PROVIDER_CONCURRENCY=2
PROVIDER_REQUEST_LIMIT=60
PROVIDER_REQUEST_WINDOW_SECONDS=60
DOCUMENT_EXTRACTION_CONCURRENCY=1

# Optional explicit font file and collection face for required PDF language coverage.
PDF_FONT_PATH=
PDF_FONT_NAME=

# Bounded upload/fetch limits. Values are bytes and milliseconds.
MAX_UPLOAD_BYTES=5242880
MAX_FETCH_BYTES=2097152
FETCH_TIMEOUT_MS=10000

# Private object storage. Use local for filesystem compatibility or s3 for MinIO/S3.
STORAGE_PROVIDER=local
STORAGE_DIR=./.data
STORAGE_MAX_OBJECT_BYTES=25000000
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=research-workbench
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ClamAV is mandatory and fail-closed in production. Mock is for explicit local fixtures only.
MALWARE_SCANNER_PROVIDER=mock
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
MALWARE_SCAN_TIMEOUT_MS=15000
MALWARE_MAX_FILE_BYTES=25000000
MALWARE_REQUIRED=true
MALWARE_ALLOW_DEMO_BYPASS=false

# Operator authentication. Generate a random 32+ character secret for production.
AUTH_ENABLED=true
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=43200
AUTH_COOKIE_SECURE=false
AUTH_DEMO_BYPASS=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900

# Optional JSON array of provider/model prices. Unconfigured models remain UNKNOWN, never zero.
MODEL_PRICING_JSON=
