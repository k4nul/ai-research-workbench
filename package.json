{
  "name": "ai-research-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-first research operations workbench for small research teams.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "dev:all": "tsx scripts/dev-all.ts",
    "start": "next start --hostname 0.0.0.0 --port 3100",
    "worker": "tsx worker/main.ts",
    "worker:readiness": "tsx scripts/worker-readiness.ts",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:prepare && vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "npm run test:prepare && vitest run tests/integration",
    "test:workers": "npm run test:prepare && vitest run tests/unit/durable-execution.test.ts tests/integration/durable-execution.test.ts tests/integration/operational-services.test.ts",
    "test:documents": "npm run test:prepare && vitest run --no-file-parallelism tests/unit/document-storage.test.ts tests/unit/orphan-cleanup.test.ts tests/integration/documents.test.ts tests/integration/document-api-worker.test.ts tests/integration/storage-cleanup-worker.test.ts tests/integration/document-s3.test.ts tests/integration/document-clamav.test.ts",
    "test:providers": "vitest run tests/unit/providers.test.ts tests/contract/providers.test.ts",
    "test:providers:live": "tsx scripts/provider-canary.ts",
    "test:prepare": "tsx scripts/prepare-test-db.ts",
    "test:e2e": "npm run test:prepare && playwright test",
    "verify": "npm run lint && npm run typecheck && npm run docs:validate && npm test && npm run build",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "db:migrate": "tsx scripts/migrate.ts",
    "migrate": "npm run db:migrate",
    "db:reset": "tsx scripts/reset-database.ts",
    "seed": "tsx scripts/seed.ts",
    "setup": "npm run db:start && npm run db:migrate && npm run seed",
    "export-demo": "tsx scripts/export-demo.ts",
    "eval": "npm run eval:mock",
    "eval:mock": "tsx scripts/eval.ts",
    "eval:live": "tsx scripts/eval.ts --live",
    "smoke:research-run": "tsx scripts/smoke-research-run.ts",
    "release:prepare": "tsx scripts/release-artifacts.ts",
    "release:verify": "tsx scripts/verify-release-artifacts.ts",
    "operator:create": "tsx scripts/operator-create.ts",
    "cleanup:orphans": "tsx scripts/cleanup-orphans.ts",
    "validate:secrets": "tsx scripts/scan-secrets.ts",
    "docs:validate": "tsx scripts/validate-management.ts",
    "doctor": "tsx scripts/doctor.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "archiver": "8.0.0",
    "argon2": "0.45.1",
    "docx": "9.7.1",
    "dotenv": "^17.2.2",
    "fast-xml-parser": "5.11.1",
    "lucide-react": "^0.542.0",
    "next": "16.3.3",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "tsx": "^4.20.5",
    "undici": "^7.16.0",
    "yauzl": "3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/archiver": "8.0.0",
    "@types/node": "^22.18.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "2.16.1",
    "@types/yauzl": "3.4.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.3",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
